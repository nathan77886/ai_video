# MiniMax 密钥只放环境变量。默认不允许付费调用。
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com
# CLIProxyAPI/OpenAI 兼容接口密钥。不要填入项目文件或日志。
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
OPENAI_API_KEY_SECRET_FILE=/mnt/ssd/cli-proxy-api/ai-video-openai.key
OPENAI_IMAGE_BASE_URL=http://host.docker.internal:8317/v1
ALLOW_PAID_GENERATION=false
APP_PORT=8081

WORKER_COUNT=2
POLL_INTERVAL=10s
MAX_UPLOAD_BYTES=262144000
MAX_DOWNLOAD_BYTES=2147483648
